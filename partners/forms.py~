from django import forms
from django.core.validators import RegexValidator

from .models import Supplier, Customer, SupplierPayment, CustomerPayment


class SupplierForm(forms.ModelForm):
    class Meta:
        model = Supplier
        fields = ['name', 'phone_number', 'initial_debt']
        widgets = {
            'phone_number': forms.TextInput(attrs={'placeholder': '+998901234567'}),  # 13 ta belgi
            'initial_debt': forms.NumberInput(attrs={'step': '0.01'}),
        }

    def clean_phone_number(self):
        phone_number = self.cleaned_data['phone_number']
        if not phone_number.startswith('+') or len(phone_number) != 13:  # + dan tashqari 12 ta belgi
            raise forms.ValidationError("Telefon raqami + bilan boshlanishi va undan keyin 12 ta raqamdan iborat bo'lishi kerak (umumiy 13 ta belgi).")
        return phone_number


class CustomerForm(forms.ModelForm):
    class Meta:
        model = Customer
        fields = ['name', 'phone_number', 'initial_debt', 'notes']
        widgets = {
            'name': forms.TextInput(attrs={'class': 'form-control', 'placeholder': 'Ism'}),
            'phone_number': forms.TextInput(attrs={'class': 'form-control', 'placeholder': '+998901234567'}),
            'initial_debt': forms.NumberInput(attrs={'class': 'form-control', 'step': '0.01'}),
            'notes': forms.Textarea(attrs={'class': 'form-control', 'rows': 3, 'placeholder': 'Izohlar...'}),
        }

    def clean_phone_number(self):
        phone_number = self.cleaned_data.get('phone_number')
        if not phone_number:
            raise forms.ValidationError("Telefon raqami kiritilishi shart.")

        # Telefon raqam formati: + bilan boshlanishi va 13 ta belgi bo‘lishi kerak
        if not phone_number.startswith('+') or len(phone_number) != 13:
            raise forms.ValidationError("Telefon raqami + bilan boshlanishi va undan keyin 12 ta raqamdan iborat bo'lishi kerak (masalan: +998901234567).")

        # Faqat raqamlardan iborat bo‘lishini tekshirish (+ dan tashqari)
        if not phone_number[1:].isdigit():
            raise forms.ValidationError("Telefon raqami faqat raqamlardan iborat bo‘lishi kerak (masalan: +998901234567).")

        # Takrorlanishni tekshirish
        customer_id = self.instance.pk if self.instance else None
        if Customer.objects.filter(phone_number=phone_number).exclude(pk=customer_id).exists():
            raise forms.ValidationError("Bu telefon raqami allaqachon ro‘yxatdan o‘tgan.")

        return phone_number

    def clean_initial_debt(self):
        initial_debt = self.cleaned_data.get('initial_debt')
        if initial_debt is None:
            raise forms.ValidationError("Boshlang'ich qarz miqdori kiritilishi shart.")
        if initial_debt < 0:
            raise forms.ValidationError("Boshlang'ich qarz miqdori salbiy bo‘lishi mumkin emas.")
        return initial_debt

    def clean_name(self):
        name = self.cleaned_data.get('name')
        if not name:
            raise forms.ValidationError("Ism kiritilishi shart.")
        if len(name.strip()) < 2:
            raise forms.ValidationError("Ism kamida 2 ta belgidan iborat bo‘lishi kerak.")
        return name.strip()

    def clean_notes(self):
        notes = self.cleaned_data.get('notes')
        if notes and len(notes.strip()) > 500:
            raise forms.ValidationError("Izoh 500 belgidan oshmasligi kerak.")
        return notes


class SupplierPaymentForm(forms.ModelForm):
    date = forms.DateField(widget=forms.DateInput(attrs={'type': 'date'}), label="Sana")

    class Meta:
        model = SupplierPayment
        fields = ['date', 'supplier', 'amount', 'payment_type', 'note']
        widgets = {
            'payment_type': forms.Select(choices=(('cash', 'Naqd'), ('card', 'Karta'))),
            'amount': forms.NumberInput(attrs={'step': '0.01'}),
            'note': forms.Textarea(attrs={'rows': 4}),
        }



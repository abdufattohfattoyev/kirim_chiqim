{% extends "index.html" %}
{% block title %}Xaridor qo'shish{% endblock %}
{% block content %}
<div class="container mt-4">
    <h2>Xaridor qo'shish</h2>
    {% if messages %}
    <div class="alert alert-dismissible fade show" role="alert">
        {% for message in messages %}
        <div class="alert-{{ message.tags }}">{{ message }}</div>
        {% endfor %}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}
    <form method="post">
        {% csrf_token %}
        <div class="mb-3">
            <label for="{{ form.name.id_for_label }}" class="form-label">Ism</label>
            {{ form.name }}
            {% if form.name.errors %}
            <div class="text-danger">{{ form.name.errors }}</div>
            {% endif %}
        </div>
        <div class="mb-3">
            <label for="{{ form.phone_number.id_for_label }}" class="form-label">Telefon raqami</label>
            {{ form.phone_number }}
            {% if form.phone_number.errors %}
            <div class="text-danger">{{ form.phone_number.errors }}</div>
            {% endif %}
        </div>
        <div class="mb-3">
            <label for="{{ form.initial_debt.id_for_label }}" class="form-label">Boshlang'ich qarz</label>
            {{ form.initial_debt }}
            {% if form.initial_debt.errors %}
            <div class="text-danger">{{ form.initial_debt.errors }}</div>
            {% endif %}
        </div>
        <div class="mb-3">
            <label for="{{ form.address.id_for_label }}" class="form-label">Manzil</label>
            {{ form.address }}
            {% if form.address.errors %}
            <div class="text-danger">{{ form.address.errors }}</div>
            {% endif %}
        </div>
        <button type="submit" class="btn btn-primary">Saqlash</button>
        <a href="{% url 'customer_list' %}" class="btn btn-secondary">Bekor qilish</a>
    </form>
</div>
{% endblock %}

{% extends "index.html" %}
{% block title %}Chiqim qo'shish{% endblock %}
{% block content %}
<div class="container-fluid py-4">
    <div class="card">
        <div class="card-header">
            <h4>Chiqim qo'shish</h4>
        </div>
        <div class="card-body">
            {% if messages %}
            <div class="alert alert-dismissible fade show">
                {% for message in messages %}
                <div class="alert alert-{{ message.tags }}">{{ message }}</div>
                {% endfor %}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            {% endif %}

            <form method="post" id="chiqim-form">
                {% csrf_token %}
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="{{ form.date.id_for_label }}" class="form-label">Sana*</label>
                        {{ form.date }}
                        {% if form.date.errors %}<div class="text-danger">{{ form.date.errors }}</div>{% endif %}
                    </div>
                    <div class="col-md-6">
                        <label for="{{ form.warehouse.id_for_label }}" class="form-label">Ombor*</label>
                        {{ form.warehouse }}
                        {% if form.warehouse.errors %}<div class="text-danger">{{ form.warehouse.errors }}</div>{% endif %}
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="{{ form.customer.id_for_label }}" class="form-label">Xaridor</label>
                        {{ form.customer }}
                        {% if form.customer.errors %}<div class="text-danger">{{ form.customer.errors }}</div>{% endif %}
                    </div>
                    <div class="col-md-6">
                        <label for="{{ form.paid_amount.id_for_label }}" class="form-label">To'langan summa</label>
                        {{ form.paid_amount }}
                        {% if form.paid_amount.errors %}<div class="text-danger">{{ form.paid_amount.errors }}</div>{% endif %}
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="id_total_amount" class="form-label">Jami summa*</label>
                        <input type="number" id="id_total_amount" name="total_amount" class="form-control" step="0.01" readonly>
                    </div>
                    <div class="col-md-6">
                        <label for="id_debt" class="form-label">Qarz</label>
                        <input type="number" id="id_debt" name="debt" class="form-control" step="0.01" readonly>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="{{ form.note.id_for_label }}" class="form-label">Izoh</label>
                    {{ form.note }}
                    {% if form.note.errors %}<div class="text-danger">{{ form.note.errors }}</div>{% endif %}
                </div>

                <h5 class="mb-3">Mahsulotlar*</h5>
                {{ formset.management_form }}
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Mahsulot*</th>
                                <th>Miqdor*</th>
                                <th>Narx*</th>
                                <th>Jami</th>
                                <th>Mavjud</th>
                                <th>O'chirish</th>
                            </tr>
                        </thead>
                        <tbody id="formset-container">
                            {% for form in formset %}
                            <tr class="formset-row" data-form-index="{{ forloop.counter0 }}">
                                <td>
                                    {{ form.product }}
                                    {% for hidden in form.hidden_fields %}{{ hidden }}{% endfor %}
                                    {% if form.product.errors %}<div class="text-danger small">{{ form.product.errors }}</div>{% endif %}
                                </td>
                                <td>
                                    {{ form.quantity }}
                                    {% if form.quantity.errors %}<div class="text-danger small">{{ form.quantity.errors }}</div>{% endif %}
                                </td>
                                <td>
                                    {{ form.price }}
                                    {% if form.price.errors %}<div class="text-danger small">{{ form.price.errors }}</div>{% endif %}
                                </td>
                                <td><input type="number" class="form-control row-total" step="0.01" readonly></td>
                                <td><span class="badge bg-info available-stock">0</span></td>
                                <td>
                                    {{ form.DELETE }}
                                    <button type="button" class="btn btn-sm btn-danger delete-row">O'chirish</button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <button type="button" id="add-formset-row" class="btn btn-success mb-3">
                    <i class="fas fa-plus"></i> Yangi mahsulot qo'shish
                </button>

                <div class="row">
                    <div class="col-md-6">
                        <div class="alert alert-info">
                            <strong>Umumiy summa: <span id="grand-total">0</span> so'm</strong>
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <a href="{% url 'outgoing_list' %}" class="btn btn-secondary me-2">Orqaga</a>
                        <button type="submit" id="submit-btn" class="btn btn-primary">
                            <i class="fas fa-save"></i> Saqlash
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function() {
    const formsetContainer = $('#formset-container');
    const addButton = $('#add-formset-row');
    const totalFormsInput = $('#id_form-TOTAL_FORMS');
    const grandTotalDisplay = $('#grand-total');
    let formCount = parseInt(totalFormsInput.val());

    // Warehouse o'zgarishida mahsulotlarni yuklash
    $('#id_warehouse').on('change', function() {
        const warehouseId = $(this).val();
        if (warehouseId) {
            loadProductsByWarehouse(warehouseId);
        } else {
            clearAllProductSelects();
        }
    });

    function clearAllProductSelects() {
        $('select[name*="-product"]').html('<option value="">Avval ombor tanlang</option>');
        $('.available-stock').text('0');
        updateAllRowTotals();
    }

    function loadProductsByWarehouse(warehouseId) {
        $.get('/inventory/get_products_by_warehouse/', {warehouse_id: warehouseId})
            .done(function(data) {
                $('select[name*="-product"]').each(function() {
                    let options = '<option value="">Mahsulot tanlang</option>';
                    if (data.products && data.products.length > 0) {
                        data.products.forEach(product => {
                            options += `<option value="${product.id}" data-stock="${product.stock}" data-unit="${product.unit}">${product.name} (${product.stock} ${product.unit})</option>`;
                        });
                    }
                    $(this).html(options);
                });
                // Warehouse o'zgargandan keyin barcha qatorlar uchun hisobni yangilash
                updateAllRowTotals();
            })
            .fail(function() {
                alert('Mahsulotlarni yuklashda xatolik yuz berdi');
            });
    }

    // Mahsulot tanlanganda mavjud miqdorni ko'rsatish
    $(document).on('change', 'select[name*="-product"]', function() {
        const selectedOption = $(this).find('option:selected');
        const stock = selectedOption.data('stock') || 0;
        const row = $(this).closest('.formset-row');
        row.find('.available-stock').text(stock);

        // Miqdor maydonini cheklash
        const quantityInput = row.find('input[name*="-quantity"]');
        quantityInput.attr('max', stock);

        updateRowTotal(row);
    });

    function addNewRow() {
        const newRow = formsetContainer.find('.formset-row').first().clone();

        // Barcha input va select larni tozalash
        newRow.find('input, select').each(function() {
            if (this.type === 'checkbox') {
                this.checked = false;
            } else if (!this.readOnly && this.name !== 'csrfmiddlewaretoken') {
                this.value = '';
            }
        });

        // Xatoliklarni olib tashlash
        newRow.find('.text-danger').remove();
        newRow.find('.available-stock').text('0');
        newRow.find('.row-total').val('0');

        // Form index ni yangilash
        newRow.attr('data-form-index', formCount);
        newRow.find('[name]').each(function() {
            if (this.name.includes('form-')) {
                this.name = this.name.replace(/form-\d+/, `form-${formCount}`);
                if (this.id) {
                    this.id = this.id.replace(/form-\d+/, `form-${formCount}`);
                }
            }
        });

        // Agar warehouse tanlangan bo'lsa, mahsulotlarni yuklash
        const warehouseId = $('#id_warehouse').val();
        if (warehouseId) {
            const productSelect = newRow.find('select[name*="-product"]');
            loadProductsForSelect(productSelect, warehouseId);
        } else {
            newRow.find('select[name*="-product"]').html('<option value="">Avval ombor tanlang</option>');
        }

        formsetContainer.append(newRow);
        formCount++;
        totalFormsInput.val(formCount);

        // Yangi qator qo'shilganda umumiy summani yangilash
        updateGrandTotal();
    }

    function loadProductsForSelect(selectElement, warehouseId) {
        $.get('/inventory/get_products_by_warehouse/', {warehouse_id: warehouseId})
            .done(function(data) {
                let options = '<option value="">Mahsulot tanlang</option>';
                if (data.products && data.products.length > 0) {
                    data.products.forEach(product => {
                        options += `<option value="${product.id}" data-stock="${product.stock}" data-unit="${product.unit}">${product.name} (${product.stock} ${product.unit})</option>`;
                    });
                }
                selectElement.html(options);
            });
    }

    function updateRowTotal(row) {
        const quantity = parseFloat(row.find('input[name*="-quantity"]').val()) || 0;
        const price = parseFloat(row.find('input[name*="-price"]').val()) || 0;
        const total = quantity * price;

        // Row total ni yangilash
        row.find('.row-total').val(total.toFixed(2));

        // Debug uchun
        console.log('Row updated:', {quantity, price, total});

        updateGrandTotal();
    }

    function updateAllRowTotals() {
        formsetContainer.find('.formset-row').each(function() {
            updateRowTotal($(this));
        });
    }

    function updateGrandTotal() {
        let grandTotal = 0;
        let activeRows = 0;

        formsetContainer.find('.formset-row').each(function() {
            const row = $(this);
            // Qator ko'rinadigan va DELETE checkbox belgilanmagan bo'lsa
            const deleteCheckbox = row.find('input[name*="-DELETE"]');
            const isDeleted = deleteCheckbox.length > 0 && deleteCheckbox.is(':checked');

            if (row.is(':visible') && !isDeleted) {
                const rowTotal = parseFloat(row.find('.row-total').val()) || 0;
                grandTotal += rowTotal;
                activeRows++;

                // Debug uchun
                console.log('Row total:', rowTotal, 'Running total:', grandTotal);
            }
        });

        console.log('Final grand total:', grandTotal, 'Active rows:', activeRows);

        $('#id_total_amount').val(grandTotal.toFixed(2));
        grandTotalDisplay.text(Math.round(grandTotal).toLocaleString('uz-UZ'));
        updateDebt();
    }

    function updateDebt() {
        const total = parseFloat($('#id_total_amount').val()) || 0;
        const paid = parseFloat($('#id_paid_amount').val()) || 0;
        $('#id_debt').val(Math.max(0, total - paid).toFixed(2));
    }

    // Event listeners
    $(document).on('input change keyup', 'input[name*="-quantity"], input[name*="-price"]', function() {
        const row = $(this).closest('.formset-row');

        // Miqdor tekshiruvi
        if ($(this).attr('name').includes('quantity')) {
            const quantity = parseFloat($(this).val()) || 0;
            const maxStock = parseFloat(row.find('.available-stock').text()) || 0;

            if (quantity > maxStock) {
                alert(`Diqqat! Mavjud miqdor: ${maxStock}. Siz ${quantity} kiritdingiz.`);
                $(this).addClass('is-invalid');
            } else {
                $(this).removeClass('is-invalid');
            }
        }

        console.log('Input changed:', $(this).attr('name'), $(this).val());
        updateRowTotal(row);
    });

    $(document).on('click', '.delete-row', function() {
        const row = $(this).closest('.formset-row');
        const deleteCheckbox = row.find('input[name*="-DELETE"]');

        if (deleteCheckbox.length > 0) {
            deleteCheckbox.prop('checked', true);
        }

        row.hide();
        updateGrandTotal();
    });

    // To'langan summa o'zgarganda qarzni yangilash
    $('#id_paid_amount').on('input', function() {
        updateDebt();
    });

    addButton.on('click', addNewRow);

    // Form yuborish
    $('#chiqim-form').on('submit', function(e) {
        e.preventDefault();

        let isValid = true;
        const errors = [];

        // Warehouse tekshiruvi
        if (!$('#id_warehouse').val()) {
            errors.push('Ombor tanlangan bo'lishi kerak!');
            isValid = false;
        }

        // Formset tekshiruvi
        let validRowsCount = 0;
        formsetContainer.find('.formset-row').each(function() {
            const row = $(this);
            const deleteCheckbox = row.find('input[name*="-DELETE"]');
            const isDeleted = deleteCheckbox.length > 0 && deleteCheckbox.is(':checked');

            if (row.is(':visible') && !isDeleted) {
                validRowsCount++;

                // Mahsulot tekshiruvi
                if (!row.find('select[name*="-product"]').val()) {
                    errors.push('Har bir qatorda mahsulot tanlangan bo'lishi kerak!');
                    isValid = false;
                }

                // Miqdor tekshiruvi
                const qty = parseFloat(row.find('input[name*="-quantity"]').val()) || 0;
                if (qty <= 0) {
                    errors.push('Miqdor 0 dan katta bo'lishi kerak!');
                    isValid = false;
                }

                // Narx tekshiruvi
                const price = parseFloat(row.find('input[name*="-price"]').val()) || 0;
                if (price <= 0) {
                    errors.push('Narx 0 dan katta bo'lishi kerak!');
                    isValid = false;
                }

                // Mavjud miqdor tekshiruvi
                const availableStock = parseFloat(row.find('.available-stock').text()) || 0;
                if (qty > availableStock) {
                    const productName = row.find('select[name*="-product"] option:selected').text();
                    errors.push(`${productName}: yetarli miqdor yo'q (mavjud: ${availableStock})`);
                    isValid = false;
                }
            }
        });

        if (validRowsCount === 0) {
            errors.push('Kamida bitta mahsulot qo\'shilishi kerak!');
            isValid = false;
        }

        if (isValid) {
            // Submit button ni disable qilish
            $('#submit-btn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saqlanmoqda...');
            this.submit();
        } else {
            alert('Xatoliklar mavjud:\n\n' + errors.join('\n'));
        }
    });

    // Boshlang'ich yuklanish
    const initialWarehouse = $('#id_warehouse').val();
    if (initialWarehouse) {
        loadProductsByWarehouse(initialWarehouse);
    }

    // Debug uchun test funksiyasi
    window.testCalculation = function() {
        console.log('=== TESTING CALCULATION ===');
        formsetContainer.find('.formset-row').each(function(index) {
            const row = $(this);
            const quantity = row.find('input[name*="-quantity"]').val();
            const price = row.find('input[name*="-price"]').val();
            const total = row.find('.row-total').val();
            const isVisible = row.is(':visible');
            const isDeleted = row.find('input[name*="-DELETE"]').is(':checked');

            console.log(`Row ${index}:`, {
                quantity, price, total, isVisible, isDeleted,
                quantitySelector: row.find('input[name*="-quantity"]').attr('name'),
                priceSelector: row.find('input[name*="-price"]').attr('name')
            });
        });

        updateAllRowTotals();
        console.log('=== END TEST ===');
    };

    // Sahifa yuklanganda hisoblarni yangilash
    setTimeout(function() {
        console.log('Initializing calculations...');
        updateAllRowTotals();

        // Har bir input uchun event listener qo'shish
        $('input[name*="-quantity"], input[name*="-price"]').each(function() {
            $(this).trigger('input');
        });
    }, 500);
});
</script>
{% endblock %}
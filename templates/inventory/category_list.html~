{% extends "index.html" %}
{% block title %}Kategoriyalar{% endblock %}
{% block content %}
<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0 animate-slide-down">Kategoriyalar Boshqaruvi</h2>
            <p class="text-muted mb-0 animate-slide-down delay-100">Barcha mahsulot kategoriyalari va ularning boshqaruvi</p>
        </div>
        <div class="d-flex gap-2 animate-slide-down delay-200">
            <button class="btn btn-primary btn-add-category" data-bs-toggle="modal" data-bs-target="#categoryModal">
                <i class="fas fa-plus-circle me-2"></i>Yangi kategoriya
            </button>
            <div class="dropdown">
                <button class="btn btn-outline-primary dropdown-toggle" type="button" id="actionsDropdown" data-bs-toggle="dropdown">
                    <i class="fas fa-ellipsis-v"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#productModal"><i class="fas fa-box me-2"></i>Yangi mahsulot</a></li>
                    <li><a class="dropdown-item" href="#"><i class="fas fa-file-export me-2"></i>Eksport qilish</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Sozlamalar</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="card mb-4 animate-fade-in delay-300">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <form id="search-form" class="search-box">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="fas fa-search"></i></span>
                            <input type="text" name="q" class="form-control search-input"
                                   placeholder="Kategoriya nomi bo'yicha qidirish..." value="{{ request.GET.q }}">
                            <button class="btn btn-primary" type="submit">Qidirish</button>
                        </div>
                    </form>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-2 flex-wrap">
                        <select class="form-select flex-grow-1" id="sort-select">
                            <option selected>Tartiblash</option>
                            <option value="name_asc">Nomi (A-Z)</option>
                            <option value="name_desc">Nomi (Z-A)</option>
                            <option value="products_asc">Mahsulotlar (Kam)</option>
                            <option value="products_desc">Mahsulotlar (Ko'p)</option>
                        </select>
                        <button class="btn btn-outline-secondary" id="filter-btn">
                            <i class="fas fa-filter me-2"></i>Filter
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4 mb-4" id="category-list">
        {% for category in categories %}
        <div class="col animate-fade-in-up" style="animation-delay: {{ forloop.counter|add:"3"|divisibleby:2 }}00ms">
            <div class="card category-card h-100" data-category-id="{{ category.id }}">
                <div class="card-img-top position-relative">
                    {% if category.image %}
                    <img src="{{ category.image.url }}" alt="{{ category.name }}" class="category-image">
                    {% else %}
                    <div class="category-image-placeholder">
                        <i class="fas fa-tag"></i>
                    </div>
                    {% endif %}
                    <div class="category-badge">
                        <span class="badge bg-primary">{{ category.product_count }} mahsulot</span>
                    </div>
                    <div class="category-actions">
                        <button class="btn btn-sm btn-light btn-view-products" data-category-id="{{ category.id }}">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn btn-sm btn-light btn-edit-category" data-category-id="{{ category.id }}">
                            <i class="fas fa-pencil-alt"></i>
                        </button>
                        <button class="btn btn-sm btn-light btn-delete-category" data-category-id="{{ category.id }}">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <h5 class="card-title mb-1">{{ category.name }}</h5>
                    <p class="card-text text-muted small mb-2">Oxirgi o'zgartirilgan: {{ category.updated_at|date:"d.m.Y" }}</p>
                    <div class="progress mb-2" style="height: 4px;">
                        <div class="progress-bar bg-success" style="width: {% widthratio category.product_count 50 100 %}%"></div>
                    </div>
                    <button class="btn btn-outline-primary btn-sm w-100 btn-view-products" data-category-id="{{ category.id }}">
                        <i class="fas fa-box-open me-2"></i>Mahsulotlarni ko'rish
                    </button>
                </div>
            </div>
        </div>
        {% empty %}
        <div class="col-12 animate-fade-in">
            <div class="card">
                <div class="card-body text-center py-5">
                    <div class="empty-state">
                        <i class="fas fa-tags fa-4x text-muted mb-3"></i>
                        <h4>Kategoriyalar topilmadi</h4>
                        <p class="text-muted">Hech qanday kategoriya topilmadi. Yangi kategoriya qo'shish uchun quyidagi tugmadan foydalaning.</p>
                        <button class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#categoryModal">
                            <i class="fas fa-plus me-2"></i>Yangi kategoriya
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% if page_obj.paginator.num_pages > 1 %}
    <nav class="d-flex justify-content-center animate-fade-in">
        <ul class="pagination pagination-modern">
            {% if page_obj.has_previous %}
            <li class="page-item">
                <a class="page-link" href="?page=1{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}">
                    <i class="fas fa-angle-double-left"></i>
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" href="?page={{ page_obj.previous_page_number }}{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}">
                    <i class="fas fa-angle-left"></i>
                </a>
            </li>
            {% endif %}

            {% for num in page_obj.paginator.page_range %}
                {% if num > page_obj.number|add:'-3' and num < page_obj.number|add:'3' %}
                    {% if page_obj.number == num %}
                    <li class="page-item active"><span class="page-link">{{ num }}</span></li>
                    {% else %}
                    <li class="page-item">
                        <a class="page-link" href="?page={{ num }}{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}">{{ num }}</a>
                    </li>
                    {% endif %}
                {% endif %}
            {% endfor %}

            {% if page_obj.has_next %}
            <li class="page-item">
                <a class="page-link" href="?page={{ page_obj.next_page_number }}{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}">
                    <i class="fas fa-angle-right"></i>
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" href="?page={{ page_obj.paginator.num_pages }}{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}">
                    <i class="fas fa-angle-double-right"></i>
                </a>
            </li>
            {% endif %}
        </ul>
    </nav>
    {% endif %}

    <!-- Products Panel (Initially Hidden) -->
    <div class="products-panel" id="products-panel">
        <div class="products-panel-header">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="fas fa-boxes me-2"></i> <span id="panel-category-name">Mahsulotlar</span></h4>
                <button class="btn btn-sm btn-close-panel">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
        <div class="products-panel-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th width="50px"></th>
                            <th>Mahsulot</th>
                            <th class="text-center">Miqdor</th>
                            <th class="text-center">Minimal</th>
                            <th>Ombor</th>
                            <th>Holati</th>
                            <th class="text-end">Harakatlar</th>
                        </tr>
                    </thead>
                    <tbody id="products-table-body">
                        <!-- Products will be loaded here dynamically -->
                    </tbody>
                </table>
            </div>
            <div class="text-center py-5" id="products-empty-state">
                <div class="empty-state">
                    <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                    <h5>Mahsulotlar topilmadi</h5>
                    <p class="text-muted">Ushbu kategoriyada hech qanday mahsulot topilmadi.</p>
                    <button class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#productModal">
                        <i class="fas fa-plus me-2"></i>Yangi mahsulot
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Modal -->
    <div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="categoryModalLabel">Yangi kategoriya</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="category-form" enctype="multipart/form-data">
                    <div class="modal-body">
                        {% csrf_token %}
                        <input type="hidden" name="category_id" id="category-id">
                        <div class="mb-3">
                            <label for="category-name" class="form-label">Kategoriya nomi</label>
                            <input type="text" class="form-control" id="category-name" name="name" required>
                        </div>
                        <div class="mb-3">
                            <label for="category-image" class="form-label">Kategoriya rasmi</label>
                            <div class="image-upload-container">
                                <div class="image-preview" id="category-image-preview">
                                    <div class="image-preview-placeholder">
                                        <i class="fas fa-image"></i>
                                        <span>Rasm yuklang</span>
                                    </div>
                                    <img id="category-preview-image" src="#" alt="Preview" style="display: none;">
                                </div>
                                <input type="file" class="form-control d-none" id="category-image" name="image" accept="image/*">
                                <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="upload-category-image">
                                    <i class="fas fa-upload me-2"></i>Rasm tanlash
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm mt-2 ms-2" id="remove-category-image" style="display: none;">
                                    <i class="fas fa-trash me-2"></i>O'chirish
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bekor qilish</button>
                        <button type="submit" class="btn btn-primary" id="save-category-btn">
                            <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                            Saqlash
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Product Modal -->
    <div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="productModalLabel">Yangi mahsulot</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="product-form" enctype="multipart/form-data">
                    <div class="modal-body">
                        {% csrf_token %}
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="product-name" class="form-label">Mahsulot nomi</label>
                                    <input type="text" class="form-control" id="product-name" name="name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="product-barcode" class="form-label">Shtrix kod</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="product-barcode" name="barcode">
                                        <button class="btn btn-outline-secondary" type="button" id="generate-barcode">
                                            <i class="fas fa-barcode"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="product-warehouse" class="form-label">Ombor</label>
                                    <select class="form-select" id="product-warehouse" name="warehouse" required>
                                        <option value="">Tanlang</option>
                                        {% for warehouse in warehouses %}
                                        <option value="{{ warehouse.id }}">{{ warehouse.name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="product-category" class="form-label">Kategoriya</label>
                                    <select class="form-select" id="product-category" name="category">
                                        <option value="">Kategoriyasiz</option>
                                        {% for category in categories %}
                                        <option value="{{ category.id }}">{{ category.name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="product-quantity" class="form-label">Miqdor</label>
                                    <input type="number" step="0.01" class="form-control" id="product-quantity" name="quantity" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="product-minimum-quantity" class="form-label">Minimal miqdor</label>
                                    <input type="number" step="0.01" class="form-control" id="product-minimum-quantity" name="minimum_quantity" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="product-unit" class="form-label">O'lchov birligi</label>
                                    <select class="form-select" id="product-unit" name="unit" required>
                                        <option value="dona">Dona</option>
                                        <option value="kg">Kilogramm</option>
                                        <option value="litr">Litr</option>
                                        <option value="metr">Metr</option>
                                        <option value="m2">Kvadrat metr</option>
                                        <option value="m3">Kub metr</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="product-image" class="form-label">Mahsulot rasmi</label>
                                    <div class="image-upload-container">
                                        <div class="image-preview" id="product-image-preview">
                                            <div class="image-preview-placeholder">
                                                <i class="fas fa-image"></i>
                                                <span>Rasm yuklang</span>
                                            </div>
                                            <img id="product-preview-image" src="#" alt="Preview" style="display: none;">
                                        </div>
                                        <input type="file" class="form-control d-none" id="product-image" name="image" accept="image/*">
                                        <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="upload-product-image">
                                            <i class="fas fa-upload me-2"></i>Rasm tanlash
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm mt-2 ms-2" id="remove-product-image" style="display: none;">
                                            <i class="fas fa-trash me-2"></i>O'chirish
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bekor qilish</button>
                        <button type="submit" class="btn btn-success" id="save-product-btn">
                            <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                            Saqlash
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
$(document).ready(function() {
    // Animation helper functions
    function animateElement(element, animation, delay = 0) {
        setTimeout(() => {
            element.classList.add('animate__animated', `animate__${animation}`);
        }, delay);
    }

    // Initialize animations
    document.querySelectorAll('.animate-slide-down').forEach((el, i) => {
        animateElement(el, 'slideInDown', i * 100);
    });

    document.querySelectorAll('.animate-fade-in').forEach((el, i) => {
        animateElement(el, 'fadeIn', i * 100 + 200);
    });

    document.querySelectorAll('.animate-fade-in-up').forEach((el, i) => {
        animateElement(el, 'fadeInUp', i * 100 + 300);
    });

    // Image upload and preview for category
    $('#upload-category-image').click(function() {
        $('#category-image').click();
    });

    $('#category-image').change(function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                $('#category-preview-image').attr('src', e.target.result).show();
                $('#category-image-preview .image-preview-placeholder').hide();
                $('#remove-category-image').show();
            }
            reader.readAsDataURL(file);
        }
    });

    $('#remove-category-image').click(function() {
        $('#category-image').val('');
        $('#category-preview-image').hide().attr('src', '#');
        $('#category-image-preview .image-preview-placeholder').show();
        $(this).hide();
    });

    // Image upload and preview for product
    $('#upload-product-image').click(function() {
        $('#product-image').click();
    });

    $('#product-image').change(function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                $('#product-preview-image').attr('src', e.target.result).show();
                $('#product-image-preview .image-preview-placeholder').hide();
                $('#remove-product-image').show();
            }
            reader.readAsDataURL(file);
        }
    });

    $('#remove-product-image').click(function() {
        $('#product-image').val('');
        $('#product-preview-image').hide().attr('src', '#');
        $('#product-image-preview .image-preview-placeholder').show();
        $(this).hide();
    });

    // Generate random barcode
    $('#generate-barcode').click(function() {
        const randomBarcode = '4' + Math.floor(100000000000 + Math.random() * 900000000000);
        $('#product-barcode').val(randomBarcode);
    });

    // Category form submission
    $('#category-form').submit(function(e) {
        e.preventDefault();
        const form = $(this);
        const saveBtn = $('#save-category-btn');
        const spinner = saveBtn.find('.spinner-border');
        const buttonText = saveBtn.html();

        // Validate form
        if ($('#category-name').val().trim() === '') {
            showToast('error', 'Iltimos, kategoriya nomini kiriting.');
            $('#category-name').addClass('is-invalid');
            return;
        }

        // Show loading state
        spinner.removeClass('d-none');
        saveBtn.prop('disabled', true);

        const formData = new FormData(form[0]);
        const url = $('#category-id').val() ? `/inventory/category/edit/${$('#category-id').val()}/` : '{% url 'category_create' %}';

        $.ajax({
            url: url,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.status === 'success') {
                    const category = response.category;
                    let categoryCard = $(`.category-card[data-category-id="${category.id}"]`);

                    if (categoryCard.length) {
                        // Update existing category
                        categoryCard.find('.card-title').text(category.name);
                        categoryCard.find('.badge').text(`${category.product_count} mahsulot`);

                        if (category.image) {
                            categoryCard.find('.category-image').attr('src', category.image).show();
                            categoryCard.find('.category-image-placeholder').hide();
                        } else {
                            categoryCard.find('.category-image').hide();
                            categoryCard.find('.category-image-placeholder').show();
                        }

                        categoryCard.addClass('animate__animated animate__pulse');
                        setTimeout(() => categoryCard.removeClass('animate__animated animate__pulse'), 1000);
                    } else {
                        // Add new category
                        const newCategoryCard = $(`
                            <div class="col">
                                <div class="card category-card h-100 animate__animated animate__zoomIn" data-category-id="${category.id}">
                                    <div class="card-img-top position-relative">
                                        ${category.image ?
                                            `<img src="${category.image}" alt="${category.name}" class="category-image">` :
                                            `<div class="category-image-placeholder"><i class="fas fa-tag"></i></div>`}
                                        <div class="category-badge">
                                            <span class="badge bg-primary">${category.product_count} mahsulot</span>
                                        </div>
                                        <div class="category-actions">
                                            <button class="btn btn-sm btn-light btn-view-products" data-category-id="${category.id}">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light btn-edit-category" data-category-id="${category.id}">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light btn-delete-category" data-category-id="${category.id}">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <h5 class="card-title mb-1">${category.name}</h5>
                                        <p class="card-text text-muted small mb-2">Oxirgi o'zgartirilgan: ${new Date().toLocaleDateString()}</p>
                                        <div class="progress mb-2" style="height: 4px;">
                                            <div class="progress-bar bg-success" style="width: ${Math.min(category.product_count * 2, 100)}%"></div>
                                        </div>
                                        <button class="btn btn-outline-primary btn-sm w-100 btn-view-products" data-category-id="${category.id}">
                                            <i class="fas fa-box-open me-2"></i>Mahsulotlarni ko'rish
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `);

                        $('#category-list').prepend(newCategoryCard);
                    }

                    $('#categoryModal').modal('hide');
                    showToast('success', response.message);
                } else {
                    showToast('error', response.message || 'Xatolik yuz berdi.');
                }
            },
            error: function(xhr) {
                let errorMsg = 'Server bilan bog\'lanishda xatolik yuz berdi.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMsg = xhr.responseJSON.message;
                } else if (xhr.status === 400) {
                    errorMsg = 'Bu nomdagi kategoriya allaqachon mavjud.';
                }
                showToast('error', errorMsg);
            },
            complete: function() {
                spinner.addClass('d-none');
                saveBtn.prop('disabled', false).html(buttonText);
            }
        });
    });

    // Product form submission
    $('#product-form').submit(function(e) {
        e.preventDefault();
        const form = $(this);
        const saveBtn = $('#save-product-btn');
        const spinner = saveBtn.find('.spinner-border');
        const buttonText = saveBtn.html();

        // Validate form
        let isValid = true;
        $('.is-invalid').removeClass('is-invalid');

        if ($('#product-name').val().trim() === '') {
            $('#product-name').addClass('is-invalid');
            isValid = false;
        }

        if ($('#product-warehouse').val() === '') {
            $('#product-warehouse').addClass('is-invalid');
            isValid = false;
        }

        if ($('#product-quantity').val() === '' || parseFloat($('#product-quantity').val()) < 0) {
            $('#product-quantity').addClass('is-invalid');
            isValid = false;
        }

        if ($('#product-minimum-quantity').val() === '' || parseFloat($('#product-minimum-quantity').val()) < 0) {
            $('#product-minimum-quantity').addClass('is-invalid');
            isValid = false;
        }

        if ($('#product-unit').val() === '') {
            $('#product-unit').addClass('is-invalid');
            isValid = false;
        }

        if (!isValid) {
            showToast('error', 'Iltimos, barcha majburiy maydonlarni to\'ldiring.');
            return;
        }

        // Show loading state
        spinner.removeClass('d-none');
        saveBtn.prop('disabled', true);

        const formData = new FormData(form[0]);

        $.ajax({
            url: '{% url 'product_create' %}',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.status === 'success') {
                    const product = response.product;
                    const categoryId = $('#product-category').val();

                    // Update category product count if category is selected
                    if (categoryId) {
                        const categoryCard = $(`.category-card[data-category-id="${categoryId}"]`);
                        if (categoryCard.length) {
                            const badge = categoryCard.find('.badge');
                            const currentCount = parseInt(badge.text().split(' ')[0]);
                            badge.text(`${currentCount + 1} mahsulot`);

                            // Update progress bar
                            const progressBar = categoryCard.find('.progress-bar');
                            const newWidth = Math.min((currentCount + 1) * 2, 100);
                            progressBar.css('width', `${newWidth}%`);

                            categoryCard.addClass('animate__animated animate__pulse');
                            setTimeout(() => categoryCard.removeClass('animate__animated animate__pulse'), 1000);
                        }
                    }

                    $('#productModal').modal('hide');
                    showToast('success', response.message);

                    // If products panel is open for this category, reload products
                    if ($('#products-panel').is(':visible') && $('#products-panel').data('category-id') == categoryId) {
                        loadCategoryProducts(categoryId);
                    }
                } else {
                    showToast('error', response.message || 'Xatolik yuz berdi.');
                }
            },
            error: function(xhr) {
                let errorMsg = 'Server bilan bog\'lanishda xatolik yuz berdi.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMsg = xhr.responseJSON.message;
                } else if (xhr.status === 400) {
                    errorMsg = 'Forma to\'ldirishda xatolik: ' + (xhr.responseJSON.errors || 'Noma\'lum xatolik');
                }
                showToast('error', errorMsg);
            },
            complete: function() {
                spinner.addClass('d-none');
                saveBtn.prop('disabled', false).html(buttonText);
            }
        });
    });

    // Edit category button
    $(document).on('click', '.btn-edit-category', function() {
        const categoryId = $(this).data('category-id');
        const card = $(this).closest('.category-card');

        // Add animation to clicked button
        $(this).addClass('animate__animated animate__rubberBand');
        setTimeout(() => $(this).removeClass('animate__animated animate__rubberBand'), 1000);

        $.ajax({
            url: `/inventory/category/edit/${categoryId}/`,
            type: 'GET',
            success: function(response) {
                if (response.status === 'success') {
                    const category = response.category;

                    // Set modal title
                    $('#categoryModalLabel').text('Kategoriyani tahrirlash');

                    // Fill form fields
                    $('#category-id').val(category.id);
                    $('#category-name').val(category.name);

                    // Handle image
                    if (category.image) {
                        $('#category-preview-image').attr('src', category.image).show();
                        $('#category-image-preview .image-preview-placeholder').hide();
                        $('#remove-category-image').show();
                    } else {
                        $('#category-preview-image').hide();
                        $('#category-image-preview .image-preview-placeholder').show();
                        $('#remove-category-image').hide();
                    }

                    // Show modal
                    $('#categoryModal').modal('show');
                } else {
                    showToast('error', response.message || 'Kategoriya ma\'lumotlarini olishda xatolik yuz berdi.');
                }
            },
            error: function(xhr) {
                const errorMsg = xhr.responseJSON?.message || 'Server bilan bog\'lanishda xatolik yuz berdi.';
                showToast('error', errorMsg);
            }
        });
    });

    // Delete category button
    $(document).on('click', '.btn-delete-category', function() {
        const categoryId = $(this).data('category-id');
        const card = $(this).closest('.category-card');

        // Add animation to clicked button
        $(this).addClass('animate__animated animate__headShake');
        setTimeout(() => $(this).removeClass('animate__animated animate__headShake'), 1000);

        Swal.fire({
            title: 'Kategoriyani o\'chirish',
            html: `<p>Ushbu kategoriyani o'chirishni tasdiqlaysizmi?</p>
                  <p class="text-danger"><strong>Diqqat!</strong> Kategoriya bilan birga uning barcha mahsulotlari ham o'chib ketishi mumkin!</p>`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Ha, o\'chirish',
            cancelButtonText: 'Bekor qilish',
            customClass: {
                confirmButton: 'btn btn-danger me-2',
                cancelButton: 'btn btn-secondary'
            },
            buttonsStyling: false,
            showClass: {
                popup: 'animate__animated animate__fadeInDown'
            },
            hideClass: {
                popup: 'animate__animated animate__fadeOutUp'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: `/inventory/category/delete/${categoryId}/`,
                    type: 'POST',
                    data: {
                        'csrfmiddlewaretoken': '{{ csrf_token }}',
                    },
                    beforeSend: function() {
                        card.addClass('animate__animated animate__pulse');
                    },
                    success: function(response) {
                        if (response.status === 'success') {
                            card.closest('.col').addClass('animate__animated animate__zoomOut');
                            setTimeout(() => card.closest('.col').remove(), 500);
                            showToast('success', response.message);

                            // If products panel is open for this category, hide it
                            if ($('#products-panel').is(':visible') && $('#products-panel').data('category-id') == categoryId) {
                                $('#products-panel').hide();
                            }
                        } else {
                            showToast('error', response.message || 'Kategoriyani o\'chirishda xatolik yuz berdi.');
                        }
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'Server bilan bog\'lanishda xatolik yuz berdi.';
                        showToast('error', errorMsg);
                    },
                    complete: function() {
                        card.removeClass('animate__animated animate__pulse');
                    }
                });
            }
        });
    });

    // View products button
    $(document).on('click', '.btn-view-products', function() {
        const categoryId = $(this).data('category-id');
        const card = $(this).closest('.category-card');
        const categoryName = card.find('.card-title').text();

        // Add animation to clicked button
        $(this).addClass('animate__animated animate__rubberBand');
        setTimeout(() => $(this).removeClass('animate__animated animate__rubberBand'), 1000);

        // Show loading state in panel
        $('#panel-category-name').html(`<i class="fas fa-spinner fa-spin me-2"></i>${categoryName}`);
        $('#products-table-body').empty();
        $('#products-empty-state').hide();

        // Load products
        loadCategoryProducts(categoryId);

        // Set panel data
        $('#panel-category-name').text(categoryName);
        $('#products-panel').data('category-id', categoryId);

        // Show panel with animation
        $('#products-panel').show().addClass('animate__animated animate__slideInRight');
    });

    // Close products panel
    $('.btn-close-panel').click(function() {
        $('#products-panel').addClass('animate__animated animate__slideOutRight');
        setTimeout(() => {
            $('#products-panel').hide().removeClass('animate__animated animate__slideOutRight');
        }, 500);
    });

    // Function to load category products
    function loadCategoryProducts(categoryId) {
        $.ajax({
            url: `/inventory/category/${categoryId}/products/`,
            type: 'GET',
            success: function(response) {
                if (response.status === 'success') {
                    const products = response.products;
                    const tableBody = $('#products-table-body');

                    tableBody.empty();

                    if (products.length > 0) {
                        products.forEach(product => {
                            // Determine status
                            let statusClass, statusText;
                            const quantity = parseFloat(product.quantity);
                            const minQuantity = parseFloat(product.minimum_quantity);

                            if (quantity <= 0) {
                                statusClass = 'danger';
                                statusText = 'Tugagan';
                            } else if (quantity <= minQuantity) {
                                statusClass = 'warning';
                                statusText = 'Kam qolgan';
                            } else {
                                statusClass = 'success';
                                statusText = 'Mavjud';
                            }

                            // Add product row
                            tableBody.append(`
                                <tr>
                                    <td>
                                        ${product.image ?
                                            `<img src="${product.image}" alt="${product.name}" class="product-thumbnail">` :
                                            `<div class="product-thumbnail-placeholder"><i class="fas fa-box"></i></div>`}
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div>
                                                <h6 class="mb-0">${product.name}</h6>
                                                <small class="text-muted">${product.barcode || 'Shtrix kodsiz'}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">${product.quantity} ${product.unit}</td>
                                    <td class="text-center">${product.minimum_quantity} ${product.unit}</td>
                                    <td>${product.warehouse_name}</td>
                                    <td><span class="badge bg-${statusClass}">${statusText}</span></td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a class="dropdown-item" href="/inventory/product/${product.id}/"><i class="fas fa-eye me-2"></i>Ko'rish</a></li>
                                                <li><a class="dropdown-item" href="#"><i class="fas fa-pencil-alt me-2"></i>Tahrirlash</a></li>
                                                <li><a class="dropdown-item text-danger" href="#"><i class="fas fa-trash me-2"></i>O'chirish</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item" href="#"><i class="fas fa-exchange-alt me-2"></i>Ko'chirish</a></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            `);
                        });
                    } else {
                        $('#products-empty-state').show();
                    }
                } else {
                    showToast('error', response.message || 'Mahsulotlarni yuklashda xatolik yuz berdi.');
                }
            },
            error: function(xhr) {
                const errorMsg = xhr.responseJSON?.message || 'Server bilan bog\'lanishda xatolik yuz berdi.';
                showToast('error', errorMsg);
            }
        });
    }

    // Add new category button
    $('.btn-add-category').click(function() {
        $('#categoryModalLabel').text('Yangi kategoriya');
        $('#category-form')[0].reset();
        $('#category-id').val('');
        $('#category-preview-image').hide();
        $('#category-image-preview .image-preview-placeholder').show();
        $('#remove-category-image').hide();
    });

    // Toast notification function
    function showToast(icon, message) {
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            showClass: {
                popup: 'animate__animated animate__fadeInRight'
            },
            hideClass: {
                popup: 'animate__animated animate__fadeOutRight'
            },
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });

        Toast.fire({
            icon: icon,
            title: message
        });
    }

    // Reset modals when closed
    $('#categoryModal').on('hidden.bs.modal', function() {
        $('#category-form')[0].reset();
        $('#category-id').val('');
        $('#category-name').removeClass('is-invalid');
    });

    $('#productModal').on('hidden.bs.modal', function() {
        $('#product-form')[0].reset();
        $('#product-name, #product-warehouse, #product-quantity, #product-minimum-quantity, #product-unit').removeClass('is-invalid');
    });
});
</script>

<style>
/* Base Styles */
:root {
    --primary-color: #4361ee;
    --secondary-color: #3f37c9;
    --success-color: #4cc9f0;
    --info-color: #4895ef;
    --warning-color: #f8961e;
    --danger-color: #f94144;
    --light-color: #f8f9fa;
    --dark-color: #212529;
    --border-radius: 0.375rem;
    --box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    --transition: all 0.3s ease;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #f5f7fa;
}

/* Card Styles */
.card {
    border: none;
    border-radius: var(--border-radius);
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    transition: var(--transition);
    overflow: hidden;
}

.card:hover {
    box-shadow: var(--box-shadow);
    transform: translateY(-5px);
}

.category-card {
    position: relative;
}

.category-image {
    width: 100%;
    height: 150px;
    object-fit: cover;
    transition: var(--transition);
}

.category-image-placeholder {
    width: 100%;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f9fa;
    color: #adb5bd;
    font-size: 2rem;
}

.category-badge {
    position: absolute;
    top: 10px;
    right: 10px;
}

.category-actions {
    position: absolute;
    top: 10px;
    left: 10px;
    opacity: 0;
    transition: var(--transition);
}

.category-card:hover .category-actions {
    opacity: 1;
}

.category-actions .btn {
    width: 30px;
    height: 30px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 5px;
    border-radius: 50%;
}

/* Products Panel */
.products-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 70%;
    height: 100vh;
    background-color: white;
    box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
    z-index: 1050;
    display: none;
    overflow-y: auto;
}

.products-panel-header {
    padding: 1.5rem;
    border-bottom: 1px solid #eee;
    position: sticky;
    top: 0;
    background-color: white;
    z-index: 1;
}

.products-panel-body {
    padding: 1.5rem;
}

.btn-close-panel {
    background: none;
    border: none;
    font-size: 1.25rem;
    color: #6c757d;
}

.btn-close-panel:hover {
    color: var(--danger-color);
}

/* Image Upload */
.image-upload-container {
    margin-bottom: 1rem;
}

.image-preview {
    width: 100%;
    height: 200px;
    border: 2px dashed #dee2e6;
    border-radius: var(--border-radius);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    background-color: #f8f9fa;
}

.image-preview-placeholder {
    text-align: center;
    color: #adb5bd;
}

.image-preview-placeholder i {
    font-size: 3rem;
    display: block;
    margin-bottom: 0.5rem;
}

.image-preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

/* Product Thumbnail */
.product-thumbnail {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 4px;
}

.product-thumbnail-placeholder {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f9fa;
    border-radius: 4px;
    color: #adb5bd;
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 2rem 0;
}

.empty-state i {
    font-size: 3rem;
    color: #adb5bd;
    margin-bottom: 1rem;
}

/* Pagination */
.pagination-modern .page-item .page-link {
    border: none;
    color: var(--dark-color);
    margin: 0 2px;
    border-radius: 50%;
}

.pagination-modern .page-item.active .page-link {
    background-color: var(--primary-color);
    color: white;
}

.pagination-modern .page-item .page-link:hover {
    background-color: #e9ecef;
}

/* Progress Bar */
.progress {
    background-color: #e9ecef;
    border-radius: 2px;
}

.progress-bar {
    transition: width 0.6s ease;
}

/* Badges */
.badge {
    font-weight: 500;
    padding: 0.35em 0.65em;
}

/* Buttons */
.btn {
    font-weight: 500;
    transition: var(--transition);
}

.btn-primary {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.btn-primary:hover {
    background-color: var(--secondary-color);
    border-color: var(--secondary-color);
}

.btn-outline-primary {
    color: var(--primary-color);
    border-color: var(--primary-color);
}

.btn-outline-primary:hover {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.btn-success {
    background-color: var(--success-color);
    border-color: var(--success-color);
}

.btn-success:hover {
    background-color: #3aa8d8;
    border-color: #3aa8d8;
}

/* Table */
.table {
    --bs-table-bg: transparent;
}

.table-hover tbody tr:hover {
    background-color: rgba(67, 97, 238, 0.05);
}

/* Animations */
.animate__animated {
    --animate-duration: 0.5s;
    opacity: 0;
}

.animate__fadeIn, .animate__fadeInUp, .animate__slideInDown, .animate__slideInRight {
    opacity: 1;
}

/* Responsive Styles */
@media (max-width: 992px) {
    .products-panel {
        width: 85%;
    }
}

@media (max-width: 768px) {
    .products-panel {
        width: 100%;
    }

    .category-image, .category-image-placeholder {
        height: 120px;
    }

    .category-actions {
        opacity: 1;
    }
}

@media (max-width: 576px) {
    .card-title {
        font-size: 1rem;
    }

    .category-badge .badge {
        font-size: 0.7rem;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
    }

    .products-panel-header h4 {
        font-size: 1.25rem;
    }

    .table th, .table td {
        padding: 0.5rem;
        font-size: 0.85rem;
    }

    .product-thumbnail, .product-thumbnail-placeholder {
        width: 30px;
        height: 30px;
    }

    .dropdown-menu {
        font-size: 0.85rem;
    }
}

/* Delay classes for animations */
.delay-100 {
    animation-delay: 100ms !important;
}

.delay-200 {
    animation-delay: 200ms !important;
}

.delay-300 {
    animation-delay: 300ms !important;
}
</style>
{% endblock %}
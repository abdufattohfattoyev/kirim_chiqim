{% extends 'base.html' %}

{% block title %}Qarz so‘ndirishlar tarixi{% endblock %}

{% block content %}
<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.4.0/css/fixedHeader.bootstrap5.min.css">
<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<style>
    :root {
        --primary-dark: #1a237e;
        --primary: #303f9f;
        --primary-light: #7986cb;
        --secondary: #ffa000;
        --success: #4caf50;
        --danger: #f44336;
        --gray-light: #f5f7fa;
        --gray-medium: #e0e5ec;
        --gray-dark: #546e7a;
    }

    /* Neumorphism Design Elements */
    .neumorphic-card {
        border-radius: 16px;
        background: var(--gray-light);
        box-shadow: 8px 8px 16px #d9dde3,
                   -8px -8px 16px #ffffff;
        border: none;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .neumorphic-card:hover {
        box-shadow: 12px 12px 24px #d1d5db,
                   -12px -12px 24px #ffffff;
        transform: translateY(-2px);
    }

    .neumorphic-btn {
        border-radius: 12px;
        background: var(--gray-light);
        box-shadow: 5px 5px 10px #d9dde3,
                   -5px -5px 10px #ffffff;
        border: none;
        transition: all 0.3s ease;
    }

    .neumorphic-btn:hover {
        box-shadow: 3px 3px 6px #d1d5db,
                   -3px -3px 6px #ffffff;
        transform: translateY(1px);
    }

    /* Header Section */
    .repayment-header {
        border-radius: 16px;
        background: white;
        box-shadow: 0 8px 24px rgba(26, 35, 126, 0.12);
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        transform: translateY(20px);
        opacity: 0;
        animation: cardEntrance 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .repayment-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 5px;
        background: linear-gradient(90deg, var(--secondary), var(--primary));
    }

    @keyframes cardEntrance {
        0% {
            transform: translateY(20px);
            opacity: 0;
        }
        100% {
            transform: translateY(0);
            opacity: 1;
        }
    }

    /* Add Repayment Button */
    .btn-add-repayment {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        border: none;
        border-radius: 12px;
        padding: 12px 24px;
        font-weight: 600;
        color: white;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        box-shadow: 0 8px 16px rgba(48, 63, 159, 0.3);
        position: relative;
        overflow: hidden;
    }

    .btn-add-repayment::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 5px;
        height: 5px;
        background: rgba(255, 255, 255, 0.5);
        opacity: 0;
        border-radius: 100%;
        transform: scale(1, 1) translate(-50%);
        transform-origin: 50% 50%;
    }

    .btn-add-repayment:hover::after {
        animation: ripple 1s ease-out;
    }

    .btn-add-repayment:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 24px rgba(48, 63, 159, 0.4);
    }

    /* Table Container */
    .repayment-table-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transform: translateY(20px);
        opacity: 0;
        animation: cardEntrance 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
    }

    /* Table Styling */
    .table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table thead {
        background: linear-gradient(135deg, var(--primary-dark), var(--primary));
        color: white;
    }

    .table thead th {
        border: none;
        font-weight: 600;
        padding: 1.25rem;
        text-align: center;
    }

    .table tbody tr {
        transition: all 0.3s ease;
        position: relative;
    }

    .table tbody tr:hover {
        background: rgba(121, 134, 203, 0.05);
        transform: translateX(8px);
    }

    .table tbody tr::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 90%;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--gray-medium), transparent);
        transform: translateX(-50%);
    }

    .table tbody td {
        vertical-align: middle;
        padding: 1.25rem;
        text-align: center;
        font-weight: 500;
    }

    /* Action Buttons */
    .btn-action {
        padding: 8px 16px;
        border-radius: 10px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin: 0 4px;
    }

    .btn-detail {
        background: linear-gradient(135deg, var(--success), #388e3c);
        color: white;
    }

    .btn-detail:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(76, 175, 80, 0.3);
    }

    .btn-edit {
        background: linear-gradient(135deg, var(--primary-light), var(--primary));
        color: white;
    }

    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(121, 134, 203, 0.3);
    }

    .btn-delete {
        background: linear-gradient(135deg, var(--danger), #d32f2f);
        color: white;
    }

    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(244, 67, 54, 0.3);
    }

    /* Modal Styles */
    .modal-content {
        border-radius: 16px;
        background: white;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        border: none;
    }

    .modal-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--gray-medium);
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
    }

    .modal-header h5 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        text-align: center;
        width: 100%;
    }

    .modal-body {
        padding: 2rem;
    }

    .modal-footer {
        padding: 1.5rem 2rem;
        border-top: 1px solid var(--gray-medium);
        background: var(--gray-light);
        display: flex;
        gap: 1rem;
        border-radius: 0 0 16px 16px;
    }

    .modal-footer .btn-cancel {
        background: linear-gradient(135deg, #f44336, #d32f2f);
        border: none;
        border-radius: 12px;
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: white;
        flex: 1;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(244, 67, 54, 0.3);
    }

    .modal-footer .btn-cancel:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(244, 67, 54, 0.4);
    }

    .modal-footer .btn-save {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        border: none;
        border-radius: 12px;
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: white;
        flex: 1;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(48, 63, 159, 0.3);
    }

    .modal-footer .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(48, 63, 159, 0.4);
    }

    /* Offcanvas (Yon panel) Styles */
    .offcanvas-end {
        width: 450px !important;
        background: white;
        box-shadow: -8px 0 24px rgba(0, 0, 0, 0.15);
        overflow-y: auto;
    }

    .offcanvas-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--gray-medium);
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
    }

    .offcanvas-header h5 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        text-align: center;
        width: 100%;
    }

    .offcanvas-body {
        padding: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        color: var(--gray-dark);
        margin-bottom: 0.75rem;
        font-size: 1rem;
    }

    .form-control {
        width: 100%;
        padding: 0.5rem 1rem;
        border: 2px solid var(--gray-medium);
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: var(--gray-light);
    }

    .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(48, 63, 159, 0.1);
        outline: none;
    }

    /* Select2 Customization */
    .select2-container--bootstrap-5 .select2-selection {
        min-height: 42px;
        border: 2px solid var(--gray-medium);
        border-radius: 12px;
        background: var(--gray-light);
        padding: 0.25rem 0.5rem;
    }

    .select2-container--bootstrap-5 .select2-selection:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(48, 63, 159, 0.1);
    }

    .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
        padding-left: 0.5rem;
    }

    .select2-container--bootstrap-5 .select2-dropdown {
        border: 2px solid var(--gray-medium);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    }

    .select2-container--bootstrap-5 .select2-results__option--selected {
        background-color: var(--primary-light);
        color: white;
    }

    .select2-container--bootstrap-5 .select2-results__option--highlighted {
        background-color: var(--primary);
        color: white;
    }

    .offcanvas-footer {
        padding: 1.5rem 2rem;
        border-top: 1px solid var(--gray-medium);
        background: var(--gray-light);
        display: flex;
        gap: 1rem;
        border-radius: 0 0 16px 16px;
    }

    .btn-save {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        border: none;
        border-radius: 12px;
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: white;
        flex: 1;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(48, 63, 159, 0.3);
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(48, 63, 159, 0.4);
    }

    .btn-cancel {
        background: linear-gradient(135deg, #f44336, #d32f2f);
        border: none;
        border-radius: 12px;
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: white;
        flex: 1;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(244, 67, 54, 0.3);
    }

    .btn-cancel:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(244, 67, 54, 0.4);
    }

    /* Empty State */
    .empty-state {
        padding: 3rem;
        text-align: center;
        color: var(--gray-dark);
    }

    .empty-state i {
        font-size: 3rem;
        color: var(--primary-light);
        margin-bottom: 1rem;
    }

    /* Pagination Styling */
    .pagination {
        justify-content: center;
        margin-top: 1.5rem;
    }

    .page-item .page-link {
        border: none;
        border-radius: 8px;
        color: var(--primary);
        background: var(--gray-light);
        margin: 0 4px;
        transition: all 0.3s ease;
        box-shadow: 3px 3px 6px #d9dde3, -3px -3px 6px #ffffff;
    }

    .page-item.active .page-link {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        box-shadow: inset 2px 2px 5px rgba(0, 0, 0, 0.2), inset -2px -2px 5px rgba(255, 255, 255, 0.1);
    }

    .page-item .page-link:hover {
        background: var(--primary-light);
        color: white;
        transform: translateY(-2px);
        box-shadow: 5px 5px 10px #d9dde3, -5px -5px 10px #ffffff;
    }

    .page-item.disabled .page-link {
        color: var(--gray-medium);
        background: var(--gray-light);
        cursor: not-allowed;
    }

    /* Responsive Adjustments */
    @media (max-width: 768px) {
        .repayment-table-container {
            overflow-x: auto;
        }

        .table {
            width: 100%;
            min-width: 600px;
        }

        .table thead th,
        .table tbody td {
            padding: 0.75rem;
            font-size: 0.9rem;
        }

        .btn-action {
            padding: 6px 12px;
            font-size: 0.8rem;
            margin: 0 2px;
        }

        .btn-add-repayment {
            padding: 10px 20px;
            font-size: 0.9rem;
        }

        .offcanvas-end {
            width: 100% !important; /* Kichik ekranlarda to‘liq kenglik */
        }

        .offcanvas-body {
            padding: 1rem;
        }

        .offcanvas-header {
            padding: 1rem;
        }

        .offcanvas-header h5 {
            font-size: 1.2rem;
        }

        .offcanvas-footer {
            padding: 1rem;
            flex-direction: column;
        }

        .btn-save,
        .btn-cancel {
            padding: 0.4rem 0.6rem;
            font-size: 0.85rem;
        }

        .form-control {
            font-size: 0.9rem;
            padding: 0.5rem;
        }

        .form-group label {
            font-size: 0.9rem;
        }
    }

    @media (max-width: 576px) {
        .repayment-header {
            padding: 1rem;
        }

        .repayment-header h2 {
            font-size: 1.2rem;
        }

        .btn-add-repayment {
            padding: 8px 16px;
            font-size: 0.8rem;
        }

        .table thead th,
        .table tbody td {
            padding: 0.5rem;
            font-size: 0.8rem;
        }

        .btn-action {
            padding: 5px 10px;
            font-size: 0.7rem;
        }
    }

    /* Animations */
    @keyframes ripple {
        0% {
            transform: scale(0, 0);
            opacity: 1;
        }
        100% {
            transform: scale(50, 50);
            opacity: 0;
        }
    }

    @keyframes floating {
        0% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-10px);
        }
        100% {
            transform: translateY(0px);
        }
    }
</style>

<div class="container mt-4">
    <!-- Header -->
    <div class="repayment-header d-flex justify-content-between align-items-center">
        <h2 class="mb-0" style="color: var(--primary-dark);">
            <i class="fas fa-money-bill-transfer me-2"></i>Qarz so‘ndirishlar tarixi
        </h2>
        <button type="button" class="btn btn-add-repayment" data-bs-toggle="offcanvas" data-bs-target="#repayOffcanvas"
            aria-controls="repayOffcanvas">
            <i class="fas fa-plus me-2"></i>Qarz so‘ndirish
        </button>
    </div>

    <!-- Repayment Table -->
    <div class="repayment-table-container">
        <table id="repaymentTable" class="table table-hover">
            <thead>
                <tr>
                    <th>Sana</th>
                    <th>Ism</th>
                    <th>Qaytarilgan summa</th>
                    <th>Amallar</th>
                </tr>
            </thead>
            <tbody>
                {% for repayment in page_obj %}
                <tr>
                    <td>{{ repayment.repayment_date|date:"Y-m-d" }}</td>
                    <td>{{ repayment.debtor.name }}</td>
                    <td class="amount-column">{{ repayment.amount }}</td>
                    <td>
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-detail btn-action me-2" data-bs-toggle="modal"
                                data-bs-target="#viewModal{{ repayment.id }}">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-edit btn-action me-2" data-bs-toggle="modal"
                                data-bs-target="#editModal{{ repayment.id }}">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-delete btn-action" data-bs-toggle="modal"
                                data-bs-target="#deleteModal{{ repayment.id }}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="4">
                        <div class="empty-state">
                            <i class="fas fa-money-bill-transfer floating"></i>
                            <h4>Hozircha qarz so‘ndirishlar yo‘q</h4>
                            <p class="text-muted">Yangi qarz so‘ndirish qo‘shish uchun yuqoridagi tugmani bosing</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Modals for View, Edit, Delete -->
    {% for repayment in page_obj %}
    <!-- View Modal -->
    <div class="modal fade" id="viewModal{{ repayment.id }}" tabindex="-1"
        aria-labelledby="viewModalLabel{{ repayment.id }}" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="viewModalLabel{{ repayment.id }}">Qarz so‘ndirish ma’lumotlari</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Sana:</strong> {{ repayment.repayment_date|date:"d.m.Y" }}</p>
                    <p><strong>Ism:</strong> {{ repayment.debtor.name }}</p>
                    <p><strong>Qaytarilgan summa:</strong> {{ repayment.amount }} so‘m</p>
                    <p><strong>Izoh:</strong> {{ repayment.description|default:"Izoh yo‘q" }}</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Yopish
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal{{ repayment.id }}" tabindex="-1"
        aria-labelledby="editModalLabel{{ repayment.id }}" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel{{ repayment.id }}">Qarz so‘ndirishni tahrirlash</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form method="POST" action="{% url 'repayment:repayment_edit' repayment.id %}"
                        onsubmit="return prepareForm(this)">
                        {% csrf_token %}
                        <div class="form-group">
                            <label class="form-label">Sana</label>
                            <input type="date" class="form-control" name="repayment_date"
                                value="{{ repayment.repayment_date|date:'Y-m-d' }}" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Ism</label>
                            <select class="form-control select2-edit" name="debtor" required>
                                {% for debtor in debtors %}
                                <option value="{{ debtor.id }}"
                                    {% if debtor.id == repayment.debtor.id %}selected{% endif %}
                                    data-balance="{{ debtor.debt_amount }}">
                                    {{ debtor.name }}
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Qaytarish summasi</label>
                            <div class="input-group">
                                <input type="text" name="amount" class="form-control"
                                    value="{{ repayment.amount|stringformat:'f' }}" oninput="formatNumber(this)"
                                    onfocus="clearDefaultValue(this)" required>
                                <span class="input-group-text">so‘m</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Izoh</label>
                            <textarea class="form-control" name="description" rows="3">{{ repayment.description }}</textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-save">
                                <i class="fas fa-save me-2"></i>Saqlash
                            </button>
                            <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
                                <i class="fas fa-times me-2"></i>Bekor qilish
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal{{ repayment.id }}" tabindex="-1"
        aria-labelledby="deleteModalLabel{{ repayment.id }}" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel{{ repayment.id }}">Qarz so‘ndirishni o‘chirish</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>{{ repayment.debtor.name }} uchun {{ repayment.amount }} so‘m qaytarilgan qarz so‘ndirishni
                        o‘chirishni xohlaysizmi?</p>
                </div>
                <div class="modal-footer">
                    <form method="POST" action="{% url 'repayment:repayment_delete' repayment.id %}">
                        {% csrf_token %}
                        <button type="submit" class="btn btn-save">
                            <i class="fas fa-trash me-2"></i>O‘chirish
                        </button>
                    </form>
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Bekor qilish
                    </button>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}

    <!-- Pagination -->
    {% if page_obj.has_other_pages %}
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <!-- Previous Page -->
            {% if page_obj.has_previous %}
            <li class="page-item">
                <a class="page-link" href="?page={{ page_obj.previous_page_number }}" aria-label="Previous">
                    <span aria-hidden="true">«</span>
                </a>
            </li>
            {% else %}
            <li class="page-item disabled">
                <a class="page-link" href="#" aria-label="Previous">
                    <span aria-hidden="true">«</span>
                </a>
            </li>
            {% endif %}

            <!-- Page Numbers -->
            {% for num in page_obj.paginator.page_range %}
            {% if page_obj.number == num %}
            <li class="page-item active">
                <a class="page-link" href="#">{{ num }}</a>
            </li>
            {% elif num > page_obj.number|add:'-3' and num < page_obj.number|add:'3' %}
            <li class="page-item">
                <a class="page-link" href="?page={{ num }}">{{ num }}</a>
            </li>
            {% endif %}
            {% endfor %}

            <!-- Next Page -->
            {% if page_obj.has_next %}
            <li class="page-item">
                <a class="page-link" href="?page={{ page_obj.next_page_number }}" aria-label="Next">
                    <span aria-hidden="true">»</span>
                </a>
            </li>
            {% else %}
            <li class="page-item disabled">
                <a class="page-link" href="#" aria-label="Next">
                    <span aria-hidden="true">»</span>
                </a>
            </li>
            {% endif %}
        </ul>
    </nav>
    {% endif %}
</div>

<!-- Yon panel (offcanvas) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="repayOffcanvas" aria-labelledby="repayOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="repayOffcanvasLabel">
            <i class="fas fa-money-bill-transfer me-2"></i>Qarz so‘ndirish
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form method="POST" id="repayForm" action="{% url 'repayment:repay' %}" onsubmit="return prepareForm(this)">
            {% csrf_token %}
            <div class="form-group">
                <label class="form-label">Sana</label>
                <input type="date" name="repayment_date" class="form-control" value="{{ today }}" required>
            </div>
            <div class="form-group">
                <label class="form-label">Ism</label>
                <select class="form-control select2" id="debtorSelect" name="debtor" required onchange="updateDebtorBalance()">
                    <option value="" disabled selected>Qarzdorni tanlang</option>
                    {% for debtor in debtors %}
                    <option value="{{ debtor.id }}" data-balance="{{ debtor.debt_amount }}">{{ debtor.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group" id="debtor-balance-info">
                <p><strong>Ushbu qarzdorning Balansi:</strong> <span id="balanceAmount">0</span> so‘m</p>
            </div>
            <div class="form-group">
                <label class="form-label">Qaytarish summasi</label>
                <div class="input-group">
                    <input type="text" name="amount" class="form-control" value="0" oninput="formatNumber(this)"
                        onfocus="clearDefaultValue(this)" required>
                    <span class="input-group-text">so‘m</span>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Izoh</label>
                <textarea class="form-control" name="description" rows="3" placeholder="Izoh (ixtiyoriy)"></textarea>
            </div>
            <div class="offcanvas-footer">
                <button type="submit" class="btn btn-save">
                    <i class="fas fa-save me-2"></i>Saqlash
                </button>
                <button type="button" class="btn btn-cancel" data-bs-dismiss="offcanvas">
                    <i class="fas fa-times me-2"></i>Bekor qilish
                </button>
            </div>
        </form>
    </div>
</div>

<!-- DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/fixedheader/3.4.0/js/dataTables.fixedHeader.min.js"></script>
<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    $(document).ready(function () {
        // Ma'lumotlar bo'sh bo'lmasa DataTables ni ishga tushiramiz
        if ($('#repaymentTable tbody tr').length > 1 || $('#repaymentTable tbody tr td').attr('colspan') !== '4') {
            $('#repaymentTable').DataTable({
                "paging": false, // Django pagination ishlatilmoqda, shuning uchun DataTables pagination o'chiriladi
                "info": false, // "Showing 1 to 10 of X entries" matni o'chiriladi
                "searching": false, // Qidiruv funksiyasi o'chiriladi
                "fixedHeader": true, // Sarlavha qotib qoladi
                "ordering": false, // Tartiblashni o'chiramiz, chunki Django tartiblashni o'zi boshqaradi
                "columnDefs": [{
                    "targets": 2, // "Qaytarilgan summa" ustuni (indeks 2)
                    "render": function (data, type, row) {
                        // Raqamni 12 000 shaklida formatlash
                        return parseFloat(data).toLocaleString('en-US');
                    }
                }]
            });
        }

        // Select2 ni ishga tushiramiz
        $('.select2').select2({
            theme: 'bootstrap-5',
            placeholder: "Qarzdorni tanlang yoki yozib qidiring",
            allowClear: true,
            width: '100%',
            language: {
                noResults: function() {
                    return "Natija topilmadi";
                },
                searching: function() {
                    return "Qidirilmoqda...";
                }
            }
        });

        // Edit modal uchun Select2
        $('.select2-edit').select2({
            theme: 'bootstrap-5',
            placeholder: "Qarzdorni tanlang yoki yozib qidiring",
            allowClear: true,
            width: '100%',
            language: {
                noResults: function() {
                    return "Natija topilmadi";
                },
                searching: function() {
                    return "Qidirilmoqda...";
                }
            }
        });

        // Modal ochilganda Select2 ni yangilash
        $('.modal').on('shown.bs.modal', function () {
            $(this).find('.select2-edit').select2({
                theme: 'bootstrap-5',
                dropdownParent: $(this)
            });
        });
    });

    // Format Number (e.g., 12000 to 12 000)
    function formatNumber(input) {
        let value = input.value.replace(/[^0-9]/g, ''); // Faqat raqamlarni olish
        if (value) {
            value = parseInt(value).toLocaleString('en-US'); // 12 000 shaklida formatlash
            input.value = value;
        } else {
            input.value = '0';
        }
    }

    // Clear Default Value on Focus
    function clearDefaultValue(input) {
        if (input.value === '0') {
            input.value = '';
        }
    }

    // Prepare Form Before Submit
    function prepareForm(form) {
        const amountInput = form.querySelector('input[name="amount"]');
        let amountValue = amountInput.value.replace(/[^0-9]/g, ''); // Faqat raqamlarni olish
        if (!amountValue || isNaN(amountValue)) {
            amountValue = '0'; // Agar qiymat bo‘sh yoki raqam bo‘lmasa, 0 qo‘yamiz
        }
        amountInput.value = amountValue; // Toza raqam sifatida saqlash

        // Agar qarzdor tanlanmagan bo'lsa, xatolik ko'rsatamiz
        const debtorSelect = form.querySelector('select[name="debtor"]');
        if (debtorSelect && !debtorSelect.value) {
            alert('Iltimos, qarzdorni tanlang!');
            return false;
        }
        return true;
    }

    // Update Debtor Balance
    function updateDebtorBalance() {
        const debtorSelect = document.getElementById('debtorSelect');
        const balanceAmount = document.getElementById('balanceAmount');

        if (debtorSelect && balanceAmount) {
            const selectedOption = debtorSelect.options[debtorSelect.selectedIndex];
            let balance = selectedOption.getAttribute('data-balance');

            // Balansni formatlash
            if (balance !== null && balance !== '' && !isNaN(parseFloat(balance))) {
                balanceAmount.textContent = parseFloat(balance).toLocaleString('en-US');
            } else {
                balanceAmount.textContent = '0';
            }
        }
    }

    // Reset Form on Offcanvas Close
    document.getElementById('repayOffcanvas').addEventListener('hidden.bs.offcanvas', function () {
        const form = document.getElementById('repayForm');
        form.reset();
        form.querySelector('input[name="amount"]').value = '0';
        document.getElementById('balanceAmount').textContent = '0';
        const debtorSelect = document.getElementById('debtorSelect');
        if (debtorSelect) {
            debtorSelect.selectedIndex = 0; // Select ni default holatga qaytarish
            $('.select2').val(null).trigger('change'); // Select2 ni ham reset qilish
        }
    });
</script>
{% endblock %}